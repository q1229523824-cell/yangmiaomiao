{
  "name": "fitness-couple-miniprogram",
  "version": "0.3.0",
  "private": true,
  "description": "离线优先的双人健身饮食微信小程序",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview:plan": "vite-node scripts/preview-plan.ts",
    "preview:takeout": "vite-node scripts/preview-takeout.ts",
    "verify:wechat": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-wechat-compiler.ps1",
    "verify:simulator": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-simulator.ps1",
    "verify:all": "npm run verify && npm run verify:wechat",
    "verify": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "miniprogram-api-typings": "^4.1.3",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
