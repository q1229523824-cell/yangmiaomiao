.header-block {
  padding: 30rpx 8rpx 24rpx;
}

.title,
.subtitle,
.member-title,
.member-subtitle,
.field-error,
.picker-label,
.picker-control__value,
.picker-control__description,
.unsaved-message,
.saved-message {
  display: block;
}

.title {
  color: #ffd200;
  font-size: 38rpx;
  font-weight: 800;
}

.subtitle {
  margin-top: 12rpx;
  color: #aaa8b8;
  font-size: 23rpx;
  line-height: 1.55;
}

.status-card,
.loading-card {
  margin-bottom: 24rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  line-height: 1.55;
}

.status-card--error {
  color: #ffd4d4;
  background: rgba(255, 82, 82, 0.18);
}

.retry-button {
  margin: 18rpx 0 0;
  min-height: 72rpx;
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  font-size: 24rpx;
  line-height: 72rpx;
}

.loading-card {
  color: #cfced8;
  text-align: center;
}

.member-card {
  padding-bottom: 32rpx;
}

.member-heading {
  margin-bottom: 22rpx;
}

.member-title {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
}

.member-subtitle {
  margin-top: 8rpx;
  color: #8f8da0;
  font-size: 22rpx;
}

.field-block {
  margin-top: 18rpx;
}

.field {
  display: flex;
  align-items: center;
}

.field__label {
  width: 132rpx;
  flex-shrink: 0;
  color: #c4c2ce;
  font-size: 25rpx;
}

.field__control,
.number-control,
.picker-control {
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.07);
}

.field__control {
  flex: 1;
  height: 76rpx;
  padding: 0 20rpx;
  color: #ffffff;
  font-size: 27rpx;
}

.number-control {
  display: flex;
  flex: 1;
  align-items: center;
  height: 76rpx;
  padding: 0 18rpx 0 20rpx;
}

.number-control__input {
  flex: 1;
  height: 74rpx;
  color: #ffffff;
  font-size: 27rpx;
}

.number-control__unit {
  margin-left: 14rpx;
  color: #8ee7df;
  font-size: 23rpx;
}

.field__control--error,
.number-control--error {
  border-color: rgba(255, 104, 104, 0.78);
  background: rgba(255, 82, 82, 0.1);
}

.field-error {
  margin: 8rpx 0 0 132rpx;
  color: #ffaaaa;
  font-size: 22rpx;
}

.field-block--picker {
  margin-top: 26rpx;
}

.picker-label {
  margin-bottom: 10rpx;
  color: #c4c2ce;
  font-size: 25rpx;
}

.picker-control {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  padding: 14rpx 20rpx;
}

.picker-control__content {
  flex: 1;
}

.picker-control__value {
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 700;
}

.picker-control__description {
  margin-top: 5rpx;
  color: #9896a8;
  font-size: 21rpx;
  line-height: 1.4;
}

.picker-control__arrow {
  margin-left: 18rpx;
  color: #ffd200;
  font-size: 44rpx;
  line-height: 1;
}

.save-panel {
  margin: 8rpx 0 26rpx;
}

.save-button {
  color: #1a1a2e;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #f7971e, #ffd200);
  font-weight: 700;
}

.save-button--disabled {
  color: #8e8b96;
  background: rgba(255, 255, 255, 0.12);
}

.unsaved-message,
.saved-message {
  margin: 0 0 14rpx;
  font-size: 24rpx;
  text-align: center;
}

.unsaved-message {
  color: #ffe08a;
}

.saved-message {
  margin-top: 16rpx;
  color: #8ee7df;
  line-height: 1.5;
}

.notice {
  margin-top: 26rpx;
  color: #aaa8b8;
  font-size: 23rpx;
  line-height: 1.65;
}

.clear-button {
  margin: 28rpx 0 18rpx;
  color: #ffb8b8;
  border: 1rpx solid rgba(255, 90, 90, 0.25);
  border-radius: 999rpx;
  background: rgba(255, 90, 90, 0.1);
  font-size: 25rpx;
}

.clear-button--disabled {
  opacity: 0.5;
}
