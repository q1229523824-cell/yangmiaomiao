.header-block {
  padding: 30rpx 8rpx 24rpx;
}

.title,
.subtitle,
.detail {
  display: block;
}

.title {
  color: #ffd200;
  font-size: 38rpx;
  font-weight: 800;
}

.subtitle,
.detail {
  margin-top: 10rpx;
  color: #9b99aa;
  font-size: 23rpx;
}

.shopping-item {
  display: flex;
  align-items: center;
}

.shopping-item--checked {
  opacity: 0.56;
}

.shopping-content {
  flex: 1;
  margin-left: 20rpx;
}

.shopping-main {
  display: flex;
  justify-content: space-between;
  color: #ffffff;
  font-size: 29rpx;
}

.grams {
  color: #8ee7df;
  flex-shrink: 0;
  margin-left: 16rpx;
  font-weight: 700;
}

.empty {
  color: #aaa8b8;
  line-height: 1.6;
  text-align: center;
}

.error-card,
.warning-card {
  color: #ffd4d4;
  background: rgba(255, 82, 82, 0.12);
  font-size: 24rpx;
  line-height: 1.55;
}

.warning-card {
  color: #ffe4a3;
  background: rgba(255, 196, 82, 0.12);
}

.retry-button {
  margin: 18rpx 0 0;
  min-height: 72rpx;
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  font-size: 24rpx;
  line-height: 72rpx;
}

.action-button {
  margin: 20rpx 0 0;
  min-height: 72rpx;
  color: #1a1a2e;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #f7971e, #ffd200);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 72rpx;
}

.saving-hint {
  margin: -8rpx 0 18rpx;
  color: #8ee7df;
  font-size: 22rpx;
  text-align: center;
}

.shopping-item--checked .shopping-main {
  text-decoration: line-through;
}
