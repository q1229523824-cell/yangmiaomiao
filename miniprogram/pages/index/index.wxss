.hero {
  padding: 28rpx 8rpx 20rpx;
  text-align: center;
}

.hero__title,
.hero__subtitle,
.section-title,
.meal-name,
.stat__label,
.stat__value {
  display: block;
}

.hero__title {
  color: #ffd200;
  font-size: 42rpx;
  font-weight: 800;
}

.hero__subtitle {
  margin-top: 12rpx;
  color: #aaa8b8;
  font-size: 25rpx;
  line-height: 1.5;
}

.setup-hint {
  margin-bottom: 24rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid rgba(255, 210, 0, 0.2);
  border-radius: 20rpx;
  background: rgba(255, 210, 0, 0.06);
  color: #d5d0be;
  font-size: 24rpx;
  line-height: 1.55;
}

.profile-link {
  min-height: 76rpx;
  margin: 10rpx 0 0;
  padding: 0 16rpx;
  border-radius: 14rpx;
  color: #ffdc66;
  background: rgba(255, 210, 0, 0.1);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 76rpx;
}

.toolbar,
.meal-heading,
.ingredient-row,
.input-row {
  display: flex;
  align-items: center;
}

.toolbar {
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.date {
  margin: 12rpx 18rpx 12rpx 0;
  color: #d8d7df;
  font-size: 27rpx;
}

.primary-button,
.send-button {
  margin: 0;
  color: #1a1a2e;
  background: linear-gradient(135deg, #f7971e, #ffd200);
  font-weight: 700;
}

.primary-button {
  min-height: 88rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  line-height: 88rpx;
}

.loading-card {
  color: #cfced8;
  font-size: 24rpx;
  line-height: 1.55;
  text-align: center;
}

.error-card {
  margin-bottom: 24rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  color: #ffd4d4;
  background: rgba(255, 82, 82, 0.18);
}

.retry-button {
  margin: 16rpx 0 0;
  min-height: 72rpx;
  color: #ffffff;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  font-size: 24rpx;
  line-height: 72rpx;
}

.blocked-menu {
  color: #ffe4a3;
  font-size: 24rpx;
  line-height: 1.6;
}

.plan-notice {
  margin-bottom: 24rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(78, 205, 196, 0.3);
  border-radius: 18rpx;
  color: #a9eee8;
  background: rgba(78, 205, 196, 0.1);
  font-size: 24rpx;
  line-height: 1.55;
}

.plan-notice--warning {
  color: #ffe4a3;
  border-color: rgba(255, 196, 82, 0.35);
  background: rgba(255, 196, 82, 0.12);
}

.section-title {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.45;
  word-break: break-all;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 20rpx;
}

.stat {
  width: 48.5%;
  margin-bottom: 14rpx;
  padding: 18rpx 10rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.06);
}

.stat__label {
  color: #9997a8;
  font-size: 22rpx;
}

.stat__value {
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
}

.locks,
.chips,
.preference-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.lock,
.preference-tag {
  margin: 0 10rpx 10rpx 0;
  padding: 9rpx 15rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.lock {
  color: #8ee7df;
  border: 1rpx solid rgba(78, 205, 196, 0.26);
  background: rgba(78, 205, 196, 0.12);
}

.assistant-reply,
.tip {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  color: #cfced8;
  background: rgba(0, 0, 0, 0.14);
  font-size: 25rpx;
  line-height: 1.6;
}

.chip {
  display: inline-flex;
  align-items: center;
  min-height: 76rpx;
  margin: 0 10rpx 10rpx 0;
  padding: 10rpx 18rpx;
  color: #e4e3eb;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  background: rgba(255, 255, 255, 0.07);
}

.input-row {
  margin-top: 14rpx;
}

.preference-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 18rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.06);
  font-size: 25rpx;
}

.send-button {
  width: 126rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
  border-radius: 18rpx;
  font-size: 25rpx;
  line-height: 88rpx;
}

.preference-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  box-sizing: border-box;
  max-width: 100%;
  white-space: normal;
  word-break: break-all;
  color: #ffe9a5;
  background: rgba(255, 210, 0, 0.13);
  border: 0;
  line-height: 1.5;
}

.preference-tag--exclude {
  color: #ffd1d1;
  background: rgba(255, 99, 99, 0.14);
}

.preference-tag--prefer {
  color: #d9ffd8;
  background: rgba(105, 210, 120, 0.14);
}

.preference-tag--safety {
  color: #ffffff;
  border: 1rpx solid rgba(255, 99, 99, 0.55);
  background: rgba(255, 99, 99, 0.22);
}

.safety-note {
  margin: 6rpx 0 12rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid rgba(255, 99, 99, 0.36);
  border-radius: 16rpx;
  color: #ffd8d8;
  background: rgba(255, 99, 99, 0.1);
  font-size: 22rpx;
  line-height: 1.55;
}

.clear-preferences {
  min-height: 76rpx;
  margin: 4rpx 0 0;
  color: #aaa8b8;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  background: transparent;
  font-size: 22rpx;
  line-height: 76rpx;
}

.meal-heading {
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.meal-name {
  margin-top: 7rpx;
  color: #ffd200;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.45;
  word-break: break-all;
}

.meal-heading__content {
  flex: 1;
  min-width: 0;
}

.meal-method {
  flex-shrink: 0;
  max-width: 170rpx;
  margin-left: 16rpx;
  color: #aaa8b8;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: right;
}

.ingredient-row {
  padding: 15rpx 0;
  border-top: 1rpx dashed rgba(255, 255, 255, 0.08);
  font-size: 25rpx;
  line-height: 1.5;
}

.ingredient-row--header {
  border-top: none;
  color: #8f8fa6;
  font-size: 22rpx;
}

.ingredient-name {
  flex: 1.35;
  min-width: 0;
  word-break: break-all;
}

.portion {
  flex: 0.75;
  min-width: 0;
  padding-left: 10rpx;
  word-break: break-all;
  color: #8ee7df;
  font-weight: 700;
  text-align: right;
}

.weight-state {
  margin-left: 8rpx;
  color: #ffd200;
  font-size: 19rpx;
}

.tip__strong {
  color: #f6c65b;
  font-weight: 700;
}

.footer-note {
  padding: 6rpx 24rpx 34rpx;
  color: #8f8fa6;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}

.offline-note {
  display: block;
  margin-top: 16rpx;
  color: #aaa8b8;
}
.date-heading, .date-options, .planning-members, .dining-options, .takeout-actions { display: flex; align-items: center; }
.date-heading { justify-content: space-between; flex-wrap: wrap; gap: 12rpx; }
.date-picker-button { padding: 16rpx; color: #ffda65; font-size: 26rpx; }
.date-options { margin: 22rpx -5rpx 10rpx; }
.date-option { flex: 1; min-width: 0; padding: 12rpx 0; margin: 0 4rpx; color: #d1cfdd; background: #292940; border-radius: 14rpx; font-size: 24rpx; line-height: 1.6; }
.date-option__status { display: block; color: #a9a6ba; font-size: 18rpx; }
.date-option--active { background: #ffd200; color: #27212a; }
.date-option--active .date-option__status { color: #62531a; }
.planning-hint, .planning-status, .household-summary, .takeout-estimate, .takeout-order, .takeout-portion, .target-warning, .estimate-note, .choice-title, .selected-badge { display: block; font-size: 24rpx; line-height: 1.65; word-break: break-all; }
.planning-hint { color: #b5b2c5; margin: 12rpx 0; }
.planning-status { color: #9cdfcc; margin-top: 16rpx; }
.planning-members { gap: 14rpx; margin-top: 18rpx; }
.member-option { flex: 1; min-width: 0; margin: 0; padding: 12rpx 14rpx; border-radius: 16rpx; font-size: 26rpx; line-height: 1.6; color: #cecbdf; background: #303047; }
.member-option--active { color: #9bf1d8; border: 2rpx solid #79cdb6; }
.dining-options { margin: 20rpx 0 12rpx; padding: 7rpx; border-radius: 18rpx; background: #161626; gap: 8rpx; }
.dining-option { flex: 1; margin: 0; min-height: 80rpx; padding: 0 14rpx; line-height: 80rpx; font-size: 28rpx; background: transparent; color: #b7b3c6; border-radius: 13rpx; }
.dining-option--active { background: #ffd200; color: #26202b; font-weight: 700; }
.household-summary { color: #a8a5bb; font-size: 22rpx; margin: 12rpx 0 20rpx; }
.selected-takeout { background: rgba(110, 220, 190, .1); border: 1rpx solid rgba(110, 220, 190, .4); border-radius: 18rpx; padding: 22rpx; margin: 18rpx 0; }
.selected-badge, .takeout-estimate { color: #9decd5; }
.takeout-estimate { margin: 10rpx 0; font-weight: 600; }
.takeout-order, .takeout-portion { color: #d9d5df; margin-top: 12rpx; }
.target-warning { color: #ffe1a0; margin: 18rpx 0; }
.inline-takeout-choice { border: 1rpx solid #43415b; border-radius: 18rpx; padding: 22rpx; margin: 18rpx 0; background: rgba(255,255,255,.035); }
.choice-title { font-size: 28rpx; font-weight: 600; color: #f4edf9; }
.takeout-actions { gap: 12rpx; flex-wrap: wrap; margin-top: 20rpx; }
.choose-takeout-button, .inline-favorite-button, .copy-order-button, .more-takeout-button { margin: 0; padding: 0 20rpx; min-height: 80rpx; line-height: 80rpx; font-size: 25rpx; border-radius: 14rpx; }
.choose-takeout-button { flex: 1; color: #192e27; background: #aee9d5; font-weight: 600; }
.choose-takeout-button--selected { background: #384a43 !important; color: #a6dac8 !important; }
.inline-favorite-button, .copy-order-button, .more-takeout-button { color: #d7d1e1; background: #363449; }
.copy-order-button { flex: 1; white-space: nowrap; }
.more-takeout-button { width: 100%; }
.estimate-note { color: #a19bac; font-size: 22rpx; margin-top: 20rpx; }
