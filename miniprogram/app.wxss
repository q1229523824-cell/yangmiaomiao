page {
  min-height: 100%;
  background: #0f0c29;
  color: #e8e8ef;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

button::after {
  border: none;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 40rpx;
  box-sizing: border-box;
  background: linear-gradient(145deg, #0f0c29 0%, #302b63 52%, #24243e 100%);
}

.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.07);
}

.muted {
  color: #aaa8b8;
}
